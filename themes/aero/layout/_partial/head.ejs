<%
// The Hugo site's head metadata, carried over: a title joined with "|" rather
// than an em dash (this site uses none anywhere), a description that falls back
// to the site's, Open Graph and Twitter cards, and a canonical link. The home
// page takes the subtitle instead, because a page titled with nothing but the
// site name tells a search engine nothing about what the site is.
const siteTitle = config.title;
let name = page.title;
if (page.tag) name = `Tagged "${page.tag}"`;
else if (!name && is_archive()) name = 'Archives';

const isHome = is_home() && !is_archive() && !page.tag;
let pageTitle = name ? `${name} | ${siteTitle}` : siteTitle;
if (isHome) pageTitle = config.tagline ? `${siteTitle}: ${config.tagline}` : siteTitle;

const description = (page.description || config.description || '').replace(/\s+/g, ' ').trim();
const canonical = page.permalink || config.url;
const image = page.cover ? full_url_for(page.cover) : '';
%>
<title><%= pageTitle %></title>
<% if (description) { %><meta name="description" content="<%= description %>"><% } %>
<meta name="author" content="<%= config.author %>">
<link rel="canonical" href="<%= canonical %>">

<meta property="og:type" content="<%= page.layout === 'post' ? 'article' : 'website' %>">
<meta property="og:site_name" content="<%= siteTitle %>">
<meta property="og:url" content="<%= canonical %>">
<meta property="og:title" content="<%= name || siteTitle %>">
<% if (description) { %><meta property="og:description" content="<%= description %>"><% } %>
<% if (image) { %>
<meta property="og:image" content="<%= image %>">
<meta name="twitter:image" content="<%= image %>">
<% } %>
<meta name="twitter:card" content="<%= image ? 'summary_large_image' : 'summary' %>">
<% if (page.layout === 'post' && page.date) { %>
<meta property="article:published_time" content="<%= page.date.toISOString() %>">
<% (page.tags && page.tags.toArray ? page.tags.toArray() : []).forEach(function (t) { %>
<meta property="article:tag" content="<%= t.name %>">
<% }); %>
<% } %>

<link rel="alternate" type="application/atom+xml" href="<%= url_for('/atom.xml') %>" title="<%= siteTitle %>">
