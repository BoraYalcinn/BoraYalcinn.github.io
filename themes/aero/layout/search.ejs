<div class="card post-full">
    <span class="post-title article-title"><%= page.title %></span>

    <div class="post-content">
        <form class="search-form" role="search" onsubmit="return false;">
            <label class="sr-only" for="search-input">Search</label>
            <input id="search-input" class="search-input" type="search"
                   placeholder="Search posts, projects and shaders"
                   autocomplete="off" data-index="<%= url_for('/search.json') %>">
        </form>
        <p class="search-status" id="search-status">Type to search.</p>
        <ul class="search-results" id="search-results"></ul>
    </div>
</div>
